# ==============================================================================
# Gyaan Setu (ज्ञान सेतु · ᱜᱽᱭᱟᱱ ᱥᱮᱛᱩ) — Environment Configuration
# ==============================================================================

# SANTALI TEXT-TO-SPEECH (TTS) CONFIGURATION
# Supported Providers: 'ai4bharat' | 'bodhan' | 'bhashini' | 'custom' | 'offline_phonetic'
# Defaults to 'ai4bharat' (Indic Parler-TTS) with seamless offline fallback.
SANTALI_TTS_PROVIDER=ai4bharat

# Option 1: AI4Bharat Indic Parler-TTS (Hugging Face Inference API or hosted container)
# Model: ai4bharat/indic-parler-tts (Supports Santali 'sat_Olck')
SANTALI_TTS_ENDPOINT=https://api-inference.huggingface.co/models/ai4bharat/indic-parler-tts
SANTALI_TTS_API_KEY=your_huggingface_token_here

# Option 2: Bodhan AI (IIT Madras Indic-Speak Education Stack)
# BODHAN_TTS_ENDPOINT=https://api.bodhan.ai/v1/tts/santali
# BODHAN_API_KEY=your_bodhan_api_key_here

# Option 3: Bhashini Cloud Open API (ULCA Pipeline)
# BHASHINI_USER_ID=your_bhashini_user_id
# BHASHINI_API_KEY=your_bhashini_api_key
# BHASHINI_PIPELINE_ID=your_pipeline_id_for_santali

# TRANSLATION CONFIGURATION (AI4Bharat IndicTrans2)
# Source languages: hin_Deva, eng_Latn
# Target language: sat_Olck (Santali Ol Chiki)
INDICTRANS2_ENDPOINT=https://api-inference.huggingface.co/models/ai4bharat/indictrans2-indic-indic-1B
INDICTRANS2_API_KEY=your_indictrans2_token_here

# LOCAL PROXY CONFIGURATION (Optional - for running a local backend without exposing keys to clients)
# PORT=3000
# CLIENT_ORIGIN=http://localhost:5173
